# Caminho: .env.example
# Copie para ".env" e ajuste os valores. O ".env" NÃO vai para o Git.
# Valores sintéticos, apenas para desenvolvimento local.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ledger
DB_USER=ledger_app
DB_PASSWORD=troque-esta-senha-local
# 8080 costuma estar ocupada no Windows; ajuste se precisar.
PORT=8081
