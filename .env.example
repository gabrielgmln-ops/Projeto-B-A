# Caminho: .env.example
# Copie para ".env" e ajuste os valores. O ".env" NÃO vai para o Git.
# Valores sintéticos, apenas para desenvolvimento local.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ledger
DB_USER=ledger_app
DB_PASSWORD=troque-esta-senha-local
# 8080 costuma estar ocupada no Windows; ajuste se precisar.
PORT=8081

# --- Usuários sintéticos de desenvolvimento (Spring Security) ---
# Criados no startup. Apenas dados sintéticos; troque as senhas localmente.
SEED_OPERADOR_USERNAME=operador
SEED_OPERADOR_SENHA=troque-esta-senha-operador
SEED_CLIENTE_USERNAME=cliente
SEED_CLIENTE_SENHA=troque-esta-senha-cliente
# Segundo cliente (opcional), para transferências entre dois titulares
SEED_CLIENTE2_USERNAME=loja
SEED_CLIENTE2_SENHA=troque-esta-senha-loja
